{
  "name": "getitdone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "node server.js",
    "test": "tsx --test tests/*.test.ts",
    "push:keys": "web-push generate-vapid-keys",
    "preview": "vite preview",
    "clean": "node -e \"for (const name of ['dist', 'server.js']) require('node:fs').rmSync(name, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "firebase-admin": "^14.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0",
    "firebase": "^12.19.0",
    "gitnexus": "^1.6.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "gaxios": { "uuid": "^11.1.1" }
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
